---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#111315" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>
      // Share the theme choice with the Starlight docs, which use the same storage key.
      (() => {
        let stored = '';
        try {
          stored = localStorage.getItem('starlight-theme') || '';
        } catch {}
        const theme =
          stored === 'light' || stored === 'dark'
            ? stored
            : matchMedia('(prefers-color-scheme: light)').matches
              ? 'light'
              : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
    scroll-behavior: smooth;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  body {
    margin: 0;
    min-width: 0;
    background: var(--q-bg);
    color: var(--q-text);
    font-family: var(--q-font-sans);
    font-size: 1rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  p {
    margin: 0;
  }

  h1,
  h2,
  h3 {
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 600;
    text-wrap: balance;
  }

  img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  a {
    color: inherit;
  }

  code,
  kbd {
    font-family: var(--q-font-mono);
  }

  :focus-visible {
    outline: 2px solid var(--q-accent-focus);
    outline-offset: 2px;
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 10;
    padding: 0.5rem 0.9rem;
    border-radius: var(--q-radius);
    background: var(--q-accent);
    color: var(--q-accent-ink);
    font-weight: 600;
    text-decoration: none;
  }

  .skip-link:focus {
    top: 1rem;
  }

  .q-wrap {
    width: 100%;
    max-width: 88rem;
    margin-inline: auto;
    padding-inline: clamp(1rem, 4vw, 3rem);
  }

  .q-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .q-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--q-line);
    border-radius: var(--q-radius);
    background: var(--q-panel);
    color: var(--q-text);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color 150ms var(--q-ease),
      border-color 150ms var(--q-ease),
      color 150ms var(--q-ease);
  }

  .q-btn:hover {
    border-color: var(--q-subtle);
    background: var(--q-panel-strong);
  }

  .q-btn:active {
    transform: translateY(1px);
  }

  .q-btn--primary {
    border-color: var(--q-accent);
    background: var(--q-accent);
    color: var(--q-accent-ink);
  }

  .q-btn--primary:hover {
    border-color: var(--q-accent);
    background: var(--q-accent);
    filter: brightness(0.94);
  }

  .q-shot {
    border: 1px solid var(--q-line);
    border-radius: var(--q-radius-lg);
    background: var(--q-panel);
    overflow: hidden;
  }

  .q-dots {
    background-color: var(--q-bg);
    background-image: radial-gradient(var(--q-grid-dot) 1px, transparent 1px);
    background-size: 18px 18px;
  }
</style>
